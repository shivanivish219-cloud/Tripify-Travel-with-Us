# Point this at your running backend.
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production (after deploying backend to Render/Railway, etc.):
# VITE_API_URL=https://your-backend.onrender.com/api

# Optional: live weather widget in the navbar.
# Free key from https://openweathermap.org/api (no card needed).
# If left blank, the weather strip simply doesn't render — nothing breaks.
VITE_OPENWEATHER_KEY=
