# ===============================================
# TRIPIFY BACKEND ENVIRONMENT CONFIGURATION
# ===============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ===============================================
# MongoDB Atlas Configuration
# ===============================================
# Create your own database user in MongoDB Atlas.
# NEVER put the real password in this file.
MONGO_URI=mongodb+srv://tripify_app_user:your_password@cluster0.nd5oeub.mongodb.net/tripify?appName=Cluster0

# ===============================================
# JWT Configuration
# ===============================================
# Use a strong random secret in your actual .env file.
JWT_SECRET=your_64_character_random_jwt_secret_here

# ===============================================
# Production Notes
# ===============================================
# NEVER commit .env to Git.
# For production, configure these values in your hosting
# platform's environment variables.